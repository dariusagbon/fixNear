{
  "name": "fixnear-rules-tests",
  "private": true,
  "description": "Security-rule and job-loop tests for FixNear, run against the Firebase Emulator Suite.",
  "type": "module",
  "scripts": {
    "test": "firebase --config ../firebase.json emulators:exec --only firestore,storage --project demo-fixnear \"node --test --test-concurrency=1 test/*.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^15.0.0"
  }
}
