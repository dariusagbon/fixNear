rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Latitude and longitude are optional, but must be set together and be
    // real coordinates when present. Older jobs have neither field.
    function validCoordinates(data) {
      let lat = data.get('latitude', null);
      let lng = data.get('longitude', null);
      return (lat == null && lng == null)
        || (lat is number && lng is number
          && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180);
    }

    // A provider's base location (optional, both halves or neither) and
    // service radius (2–50 km). Providers from before distance matching
    // have none of these fields.
    function validProviderLocation(data) {
      let lat = data.get('baseLatitude', null);
      let lng = data.get('baseLongitude', null);
      let radius = data.get('serviceRadiusKm', null);
      let hash = data.get('baseGeohash', null);
      return ((lat == null && lng == null)
          || (lat is number && lng is number
            && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180))
        && (radius == null || (radius is number && radius >= 2 && radius <= 50))
        && (hash == null || (hash is string && hash.size() <= 12));
    }

    // Profile photos are Cloudinary links (or absent).
    function validPhotoUrl(data) {
      let url = data.get('photoUrl', null);
      return url == null
        || (url is string && url.size() <= 500
          && url.matches('^https://res[.]cloudinary[.]com/.+'));
    }

    function signedInProvider() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'provider';
    }

    match /users/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'name', 'role', 'createdAt'])
        && request.resource.data.keys().hasOnly([
          'email', 'name', 'role', 'phone', 'photoUrl', 'createdAt'
        ])
        && request.resource.data.email is string
        && request.resource.data.name is string
        && request.resource.data.role in ['customer', 'provider']
        && request.resource.data.createdAt is timestamp;

      allow read: if request.auth != null && request.auth.uid == userId;

      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'phone', 'photoUrl'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 80
        && (request.resource.data.get('phone', null) == null
          || (request.resource.data.phone is string
            && request.resource.data.phone.size() <= 20))
        && validPhotoUrl(request.resource.data);

      allow delete: if false;

      // Push tokens for this user's devices. Only Cloud Functions (admin)
      // read them to send notifications; the app writes and removes its own.
      match /tokens/{token} {
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token == token
          && token.size() <= 4096
          && request.resource.data.platform in ['android', 'ios', 'web', 'other']
          && request.resource.data.updatedAt == request.time;
        allow delete: if request.auth != null && request.auth.uid == userId;
        allow read: if false;
      }
    }

    match /providerProfiles/{providerId} {
      allow create: if request.auth != null
        && request.auth.uid == providerId
        && getAfter(/databases/$(database)/documents/users/$(providerId)).data.role == 'provider'
        && request.resource.data.keys().hasOnly([
          'name', 'category', 'serviceArea', 'startingPrice', 'isAvailable', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.category is string
        && request.resource.data.serviceArea is string
        && request.resource.data.startingPrice is int
        && request.resource.data.startingPrice >= 0
        && request.resource.data.isAvailable is bool
        && request.resource.data.createdAt is timestamp;

      allow read: if request.auth != null
        && (request.auth.uid == providerId || resource.data.isAvailable == true);

      allow update: if request.auth != null
        && request.auth.uid == providerId
        && signedInProvider()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'category', 'serviceArea', 'startingPrice', 'isAvailable',
          'baseLatitude', 'baseLongitude', 'baseGeohash', 'serviceRadiusKm',
          'photoUrl'
        ])
        && validProviderLocation(request.resource.data)
        && validPhotoUrl(request.resource.data);

      allow delete: if false;
    }

    match /serviceRequests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'customer'
        && request.resource.data.keys().hasOnly([
          'customerUid', 'customerName', 'category', 'description', 'serviceArea',
          'locationLabel', 'latitude', 'longitude', 'geohash',
          'providerUid', 'providerName', 'status', 'scheduledAt', 'photoUrls',
          'declinedProviderUids', 'paymentStatus', 'createdAt', 'updatedAt'
        ])
        && (request.resource.data.get('locationLabel', null) == null
          || request.resource.data.locationLabel is string)
        && validCoordinates(request.resource.data)
        && (request.resource.data.get('geohash', null) == null
          || (request.resource.data.geohash is string
            && request.resource.data.geohash.size() <= 12))
        && request.resource.data.customerName is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && request.resource.data.serviceArea is string
        && (request.resource.data.providerUid == null || request.resource.data.providerUid is string)
        && (request.resource.data.providerName == null || request.resource.data.providerName is string)
        && (request.resource.data.providerUid == null
          || get(/databases/$(database)/documents/providerProfiles/$(request.resource.data.providerUid)).data.isAvailable == true)
        && request.resource.data.status == 'requested'
        && request.resource.data.scheduledAt is timestamp
        && request.resource.data.photoUrls is list
        && request.resource.data.photoUrls.size() <= 5
        && request.resource.data.declinedProviderUids == []
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow read: if request.auth != null
        && (resource.data.customerUid == request.auth.uid
          || (signedInProvider()
            && (resource.data.providerUid == request.auth.uid
              || (resource.data.status in ['requested', 'quoted']
                && (resource.data.providerUid == null
                  || resource.data.providerUid == request.auth.uid)))));

      allow update: if request.auth != null
        && ((resource.data.customerUid == request.auth.uid
            && resource.data.status in ['requested', 'quoted']
            && request.resource.data.status == 'cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.updatedAt is timestamp)
          || (resource.data.customerUid == request.auth.uid
            && resource.data.status in ['requested', 'quoted']
            && request.resource.data.status == 'accepted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'providerUid', 'providerName', 'quotedPrice', 'quoteNote', 'status', 'updatedAt'
            ])
            && request.resource.data.providerUid is string
            && request.resource.data.quotedPrice is int
            && request.resource.data.quoteNote is string
            && getAfter(/databases/$(database)/documents/serviceRequests/$(requestId)/quotes/$(request.resource.data.providerUid)).data.status == 'accepted'
            && request.resource.data.quotedPrice == getAfter(/databases/$(database)/documents/serviceRequests/$(requestId)/quotes/$(request.resource.data.providerUid)).data.price
            && request.resource.data.updatedAt is timestamp)
          || (signedInProvider()
            && resource.data.status in ['requested', 'quoted']
            && request.resource.data.status == 'quoted'
            && (resource.data.providerUid == null
              || resource.data.providerUid == request.auth.uid)
            && !resource.data.declinedProviderUids.hasAny([request.auth.uid])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && getAfter(/databases/$(database)/documents/serviceRequests/$(requestId)/quotes/$(request.auth.uid)).data.status == 'sent'
            && request.resource.data.updatedAt is timestamp)
          || (signedInProvider()
            && resource.data.status in ['requested', 'quoted']
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'declinedProviderUids', 'updatedAt'
            ])
            // A provider can only add themselves to the declined list.
            && request.resource.data.declinedProviderUids.toSet()
              == resource.data.declinedProviderUids.toSet().union([request.auth.uid].toSet())
            && request.resource.data.updatedAt is timestamp)
          || (signedInProvider()
            && request.auth.uid == resource.data.providerUid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.updatedAt is timestamp
            && ((resource.data.status == 'accepted' && request.resource.data.status == 'on_the_way')
              || (resource.data.status == 'on_the_way' && request.resource.data.status == 'arrived')
              || (resource.data.status == 'arrived' && request.resource.data.status == 'in_progress')
              || (resource.data.status == 'in_progress' && request.resource.data.status == 'provider_completed')))
          || (request.auth.uid == resource.data.customerUid
            && resource.data.status == 'provider_completed'
            && request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
            && request.resource.data.updatedAt is timestamp)
          || (request.auth.uid == resource.data.customerUid
            && resource.data.status == 'completed'
            && resource.data.paymentStatus == 'unpaid'
            && request.resource.data.paymentMethod == 'cash'
            && request.resource.data.paymentStatus == 'pending_provider_confirmation'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentMethod', 'paymentStatus', 'updatedAt'
            ])
            && request.resource.data.updatedAt is timestamp)
          || (signedInProvider()
            && request.auth.uid == resource.data.providerUid
            && resource.data.status == 'completed'
            && resource.data.paymentStatus == 'pending_provider_confirmation'
            && request.resource.data.paymentStatus == 'paid'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'paymentStatus', 'paidAt', 'updatedAt'
            ])
            && request.resource.data.paidAt is timestamp
            && request.resource.data.updatedAt is timestamp));

      allow delete: if false;

      match /quotes/{providerId} {
        allow read: if request.auth != null
          && (get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.customerUid == request.auth.uid
            || request.auth.uid == providerId);

        allow create: if signedInProvider()
          && request.auth.uid == providerId
          && get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.status in ['requested', 'quoted']
          && (get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.providerUid == null
            || get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.providerUid == providerId)
          && request.resource.data.keys().hasOnly([
            'providerUid', 'providerName', 'price', 'note', 'status', 'createdAt'
          ])
          && request.resource.data.providerUid == providerId
          && request.resource.data.price is int
          && request.resource.data.price > 0
          && request.resource.data.note is string
          && request.resource.data.status == 'sent'
          && request.resource.data.createdAt is timestamp;

        // The customer accepts a quote, or the provider revises their own
        // quote while the job is still open.
        allow update: if (request.auth != null
          && get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.customerUid == request.auth.uid
          && resource.data.status == 'sent'
          && request.resource.data.status == 'accepted'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
          || (signedInProvider()
            && request.auth.uid == providerId
            && resource.data.status == 'sent'
            && get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.status in ['requested', 'quoted']
            && (get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.providerUid == null
              || get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.providerUid == providerId)
            && !get(/databases/$(database)/documents/serviceRequests/$(requestId)).data.declinedProviderUids.hasAny([providerId])
            && request.resource.data.keys().hasOnly([
              'providerUid', 'providerName', 'price', 'note', 'status', 'createdAt'
            ])
            && request.resource.data.providerUid == providerId
            && request.resource.data.price is int
            && request.resource.data.price > 0
            && request.resource.data.note is string
            && request.resource.data.status == 'sent'
            && request.resource.data.createdAt is timestamp);

        allow delete: if false;
      }

      match /messages/{messageId} {
        function isParticipant() {
          let serviceRequest = get(/databases/$(database)/documents/serviceRequests/$(requestId)).data;
          return request.auth != null
            && (request.auth.uid == serviceRequest.customerUid
              || request.auth.uid == serviceRequest.providerUid);
        }

        allow read: if isParticipant();

        allow create: if isParticipant()
          && request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt is timestamp;

        allow update, delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}